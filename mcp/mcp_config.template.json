{
  "mcpServers": {
    "exa": {
      "serverUrl": "https://mcp.exa.ai/mcp"
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ],
      "disabled": false
    },
    "boekti": {
      "url": "http://localhost:8080/mcp",
      "headers": {
        "Authorization": "Bearer ${BOEKTI_TOKEN:-YOUR_BOEKTI_BEARER_TOKEN}"
      }
    }
  }
}
